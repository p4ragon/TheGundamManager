<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Anteprima foto Kit Cinese -->
        <ImageView
            android:id="@+id/img_chinpla"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Foto Kit Third Party" />

        <!-- Info Testuali -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Nome del Kit -->
            <TextView
                android:id="@+id/tv_chinpla_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kit Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Brand Produttore (es. SNAA, CangToys) -->
            <TextView
                android:id="@+id/tv_chinpla_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Brand: SNAA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_blue_dark" />

            <!-- Prezzo -->
            <TextView
                android:id="@+id/tv_chinpla_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Prezzo: € 0.00"
                android:textSize="14sp" />

            <!-- Runner avanzati -->
            <TextView
                android:id="@+id/tv_chinpla_spare_runners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Runner avanzati: No"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>